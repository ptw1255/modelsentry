{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelsentry.dev/schemas/drift-investigation-candidate.schema.json",
  "title": "DriftInvestigationCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment",
    "summary",
    "observations",
    "hypotheses",
    "limitations"
  ],
  "properties": {
    "assessment": {
      "enum": ["drift_detected", "stable", "insufficient_evidence"]
    },
    "summary": {"$ref": "#/$defs/freeText"},
    "observations": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/observation"}
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/hypothesis"}
    },
    "limitations": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/freeText"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assessment": {"enum": ["stable", "insufficient_evidence"]}
        },
        "required": ["assessment"]
      },
      "then": {"properties": {"hypotheses": {"maxItems": 0}}}
    },
    {
      "if": {
        "properties": {"assessment": {"const": "stable"}},
        "required": ["assessment"]
      },
      "then": {"properties": {"observations": {"maxItems": 0}}}
    },
    {
      "if": {
        "properties": {"assessment": {"const": "drift_detected"}},
        "required": ["assessment"]
      },
      "then": {
        "properties": {
          "observations": {"minItems": 1},
          "hypotheses": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "freeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "number", "status"],
          "properties": {
            "kind": {"const": "number"},
            "number": {"type": "number"},
            "status": {"const": "available"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text", "status"],
          "properties": {
            "kind": {"const": "text"},
            "text": {
              "enum": [
                "stable",
                "warning",
                "critical",
                "present",
                "absent_current",
                "absent_baseline"
              ]
            },
            "status": {"const": "available"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "boolean", "status"],
          "properties": {
            "kind": {"const": "boolean"},
            "boolean": {"type": "boolean"},
            "status": {"const": "available"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status"],
          "properties": {
            "kind": {"const": "unavailable"},
            "status": {
              "enum": [
                "non_finite",
                "not_applicable",
                "not_comparable",
                "left_censored",
                "category_identity_ambiguous"
              ]
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "feature_id",
        "window_start_index",
        "window_end_index",
        "evidence_family",
        "metric",
        "direction",
        "value",
        "statement"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/opaqueId"},
        "feature_id": {"$ref": "#/$defs/opaqueId"},
        "window_start_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "window_end_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "evidence_family": {
          "enum": [
            "distribution_drift",
            "location_change",
            "missingness_change",
            "category_share_change",
            "bounded_persistence",
            "history_coverage",
            "onset_proximity",
            "schema_change"
          ]
        },
        "metric": {
          "enum": [
            "psi",
            "ks_p_value",
            "severity",
            "mean_delta",
            "mean_delta_pct",
            "null_rate_delta_pp",
            "category_share_delta_pp",
            "bounded_persistence",
            "history_coverage",
            "onset_proximity",
            "feature_presence"
          ]
        },
        "direction": {
          "enum": ["increase", "decrease", "unchanged", "not_applicable"]
        },
        "value": {"$ref": "#/$defs/value"},
        "statement": {"$ref": "#/$defs/freeText"}
      }
    },
    "featureCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_code", "parameters"],
      "properties": {
        "check_code": {
          "enum": [
            "review_upstream_schema",
            "compare_population_segments",
            "verify_missingness_pipeline"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feature_ids"],
          "properties": {
            "feature_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/opaqueId"}
            }
          }
        }
      }
    },
    "nextCheck": {
      "oneOf": [
        {"$ref": "#/$defs/featureCheck"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["check_code", "parameters"],
          "properties": {
            "check_code": {"const": "review_deployment_change"},
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["check_code", "parameters"],
          "properties": {
            "check_code": {"const": "compare_scheduled_window"},
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reference_window_index"],
              "properties": {
                "reference_window_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23
                }
              }
            }
          }
        }
      ]
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "statement",
        "supporting_evidence_ids",
        "contradictory_evidence_ids",
        "next_checks"
      ],
      "properties": {
        "category": {
          "enum": [
            "upstream_data_change",
            "population_mix_change",
            "missingness_or_pipeline_failure",
            "category_or_schema_change",
            "behavioral_change",
            "model_or_serving_change",
            "seasonal_or_scheduled_change",
            "unknown"
          ]
        },
        "statement": {"$ref": "#/$defs/freeText"},
        "supporting_evidence_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "contradictory_evidence_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "next_checks": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/nextCheck"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"category": {"not": {"const": "unknown"}}},
            "required": ["category"]
          },
          "then": {
            "properties": {"supporting_evidence_ids": {"minItems": 1}}
          }
        }
      ]
    }
  }
}
